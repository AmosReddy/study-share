# Copy this file to .env.local and fill in the values. Never commit .env.local.
# On Vercel, set these in Project Settings > Environment Variables instead.
#
# Outside services use vendor-neutral names. To switch vendors later, change
# the values here. No code changes are needed for any S3-compatible storage
# or any SMTP email service.

# "dev" for local and Preview deployments, "production" for Production only.
APP_ENV=dev

# Database (any Postgres; Supabase today)
# Pooled connection (Supabase "Transaction pooler"), used by the running app
DATABASE_URL=
# Session pooler or direct connection, used only to run migrations
DATABASE_MIGRATION_URL=

# Supabase Auth and Realtime
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# File storage (any S3-compatible service; Supabase Storage today)
# Supabase: Storage > Settings > S3 Connection shows the endpoint and region
# and lets you create the access key pair.
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=
# "true" for Supabase and R2. Set "false" only if your service needs bucket.host style URLs.
STORAGE_FORCE_PATH_STYLE=true

# Email (any SMTP service; Gmail today). Gmail needs an app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# Sentry (optional: leave empty to turn error reporting off)
NEXT_PUBLIC_SENTRY_DSN=
