# Copy this file to .env.local and fill in the values. Never commit .env.local.
# On Vercel, set these in Project Settings > Environment Variables instead.

# "dev" for local and Preview deployments, "production" for Production only.
APP_ENV=dev

# Supabase: pooled connection (transaction pooler) for the running app
DATABASE_URL=
# Supabase: direct connection, used only to run migrations
DATABASE_MIGRATION_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (private bucket, token limited to that bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Gmail account used for sending email during the pilot (use an app password)
SMTP_USER=
SMTP_APP_PASSWORD=

# Sentry (optional: leave empty to turn error reporting off)
NEXT_PUBLIC_SENTRY_DSN=
